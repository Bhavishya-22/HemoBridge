# ── Backend Production Environment Configuration ──

# Server Port & Environment
PORT=3001
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local)
mongoURI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/blood-bank?retryWrites=true&w=majority

# JWT Token Secrets (Generate securely: openssl rand -hex 64)
JWT_ACCESS_SECRET=your_long_random_jwt_access_secret_64_bytes_hex
JWT_REFRESH_SECRET=your_long_random_jwt_refresh_secret_64_bytes_hex

# Allowed Frontend Origins (Comma-separated for multiple domains)
# Local: http://localhost:5173,http://localhost:5174
# Production: https://your-frontend-domain.vercel.app,https://bloodbank.org
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Google OAuth 2.0 Client ID (Matches frontend Client ID)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Email / SMTP Configuration ──
# Option 1: Generic SMTP Relay (Brevo, Mailtrap, Resend, SendGrid, Amazon SES)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_account_email@domain.com
SMTP_PASS=your_copied_brevo_smtp_key
SMTP_FROM="Blood Bank Support" <your_verified_sender_email@domain.com>

# Option 2: Gmail SMTP Relay (Requires Google Account App Password)
# SMTP_EMAIL=your_email@gmail.com
# SMTP_PASSWORD=your_16_char_google_app_password

# Default System Administrator Account
ADMIN_USERNAME=username
ADMIN_EMAIL=admin-mail
ADMIN_PASSWORD=admin-pass

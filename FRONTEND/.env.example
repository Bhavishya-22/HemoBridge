# ── Frontend Production Environment Configuration ──

# Base URL of the BloodBank Backend API
# In local development: http://localhost:3001 or http://localhost:5000
# In production: https://your-backend-domain.com
VITE_API_BASE=http://localhost:3001

# Google OAuth 2.0 Web Client ID
# Obtain from https://console.cloud.google.com/apis/credentials
# Ensure http://localhost:5173 and http://localhost:5174 are in Authorized JavaScript Origins
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

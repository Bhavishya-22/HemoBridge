# Backend API URL
# Leave blank in local development to use Vite's built-in proxy (relative paths).
# In production (e.g. Vercel/Netlify), set this to your deployed backend URL: https://your-backend.onrender.com
VITE_API_URL=

# Get your Google Client ID from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Leave empty to hide the Google sign-in button
VITE_GOOGLE_CLIENT_ID=81916670367-qfilbfs26c9okpt3enlat7irqk2stpp0.apps.googleusercontent.com

